extends layout

block content
  h1= title

  if (toShow == null)
    no instance to delete
  else
    - let aircraftid = toShow._id
    - let aircraft_type = toShow.aircraft_type
    - let capacity = toShow.capacity
    - let cruising_speed = toShow.cruising_speed
    - let actionid = "/resource/aircraft/" + aircraftid

    div
      div.row
        div(class='aircraftAttr mr-3') Aircraft ID is:
        div #{aircraftid}
      div.row
        div(class='aircraftAttr mr-3') Aircraft Type is:
        div #{aircraft_type}
      div.row
        div(class='aircraftAttr mr-3') Capacity is:
        div #{capacity}
      div.row
        div(class='aircraftAttr mr-3') Cruising Speed is:
        div #{cruising_speed}

    button(class="btn btn-danger m-2" onclick="deleteOnid()") Delete
    button(class="btn btn-secondary m-2" onclick="cancel()") Cancel

  script.
    function cancel() {
      window.location.href='/aircraft'
    }
  script.
    function deleteOnid() {
      fetch("#{actionid}", {
        method: 'DELETE'
      }).then((resp) => {
        return resp.json();
      }).then((body) => {
        alert("Delete succeded")
        window.location.href='/aircraft'
      }).catch((error) => {
        alert("Delete failed " + error )
      });
    }