extends layout

block content
  h1= title

  - let aircraftid = toShow._id
  - let aircraft_type = toShow.aircraft_type
  - let capacity = toShow.capacity
  - let cruising_speed = toShow.cruising_speed

  div.row(class='mb-2')
    div.mr-1 ID is
    div #{aircraftid}

  - let actionid = "/resource/aircraft/" + aircraftid
  form(id='AircraftForm', action=actionid, method="PUT")
      div.form-group
          label.aircraftAttr(for='aircraft_type') Aircraft type
          input#aircraft_type(type='text', name='aircraft_type', value=aircraft_type)
      div.form-group
          label.aircraftAttr(for='capacity') Capacity
          input#capacity(type='number', name='capacity', value=capacity)
      div.form-group
          label.aircraftAttr(for='cruising_speed') Cruising speed
          input#cruising_speed(type='number', name='cruising_speed', value=cruising_speed)
      input(type="submit")

  script.
    document.forms['AircraftForm'].addEventListener('submit', (event) => {
      event.preventDefault();
      fetch(event.target.action, {
        method: 'PUT',
        body: new URLSearchParams(new FormData(event.target))
      }).then((resp) => {
        return resp.json();
      }).then((body) => {
        alert("Update succeeded")
      }).catch((error) => {
        alert("Update failed " + error )
      });
    });